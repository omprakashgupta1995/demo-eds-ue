{
  "definitions": [
    {
      "id": "hero-carousel",
      "title": "Hero Carousel",
      "description": "A carousel block to display multiple items in a sliding format.",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Hero Carousel",
              "filter": "hero-carousel"
            }
          }
        }
      }
    },
    {
      "id": "hero-carousel-item",
      "title": "Hero Carousel Item",
      "description": "An item within the hero carousel, which can contain an image and text.",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Hero Carousel Item",
              "model": "hero-carousel-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "hero-carousel-item",
      "fields": [
      {
        "component": "select",
        "name": "col1_mediaType",
        "options": [
          { "label": "Image", "value": "image" },
          { "label": "Video", "value": "video" }
        ]
      },
      {
        "component": "file",
        "name": "col1_image",
        "showIf": { "field": "col1_mediaType", "equals": "image" }
      },
      {
        "component": "file",
        "name": "col1_video",
        "showIf": { "field": "col1_mediaType", "equals": "video" }
      },
       {
        "component": "text",
        "label": "Image Alt Text",
        "name": "col1_imageAlt",
        "valueType": "string"
       },
        {
          "component": "text",
          "name": "col2_ctaText",
          "label": "CTA Text",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "col2_ctaLink",
          "label": "CTA Link",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "hero-carousel",
      "components": ["hero-carousel-item"]
    }
  ]
}
