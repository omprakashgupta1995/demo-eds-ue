{
  "definitions": [
    {
      "id": "hero-caraousel",
      "title": "Hero Carousel",
      "description": "A carousel block to display multiple items in a sliding format.",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Hero Carousel",
              "filter": "hero-caraousel"
            }
          }
        }
      }
    },
    {
      "id": "hero-caraousel-item",
      "title": "Hero Carousel Item",
      "description": "An item within the hero carousel, which can contain an image and text.",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Hero Carousel Item",
              "model": "hero-caraousel-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "hero-caraousel-item",
      "fields": [
        {
          "component": "select",
          "name": "col1_mediaType",
          "label": "Media Type",
          "options": [
            { "label": "Image", "value": "image" },
            { "label": "Video", "value": "video" }
          ]
        },
        {
          "component": "file",
          "name": "col1_image",
          "label": "Image",
          "showIf": { "field": "col1_mediaType", "equals": "image" }
        },
        {
          "component": "file",
          "name": "col1_video",
          "label": "Video",
          "showIf": { "field": "col1_mediaType", "equals": "video" }
        },
        {
          "component": "text",
          "name": "col2_ctaText",
          "label": "CTA Text"
        },
        {
          "component": "text",
          "name": "col2_ctaLink",
          "label": "CTA Link"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "hero-caraousel",
      "components": ["hero-caraousel-item"]
    }
  ]
}
